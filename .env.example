# Checkout link shown inside the Upgrade to Pro dialog (must start with https://).
# Works with Gumroad, Lemon Squeezy, Stripe Payment Links, Ko-fi, etc.
# Deliver the license key in the receipt email (issue keys with `npm run license:issue -- <buyer-id>`).
VITE_CHECKOUT_URL=
VITE_PRO_PRICE=$4.99/mo or $29/yr
